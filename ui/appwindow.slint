import { Button, TextEdit, ScrollView, ComboBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "MadEdit-Rust";
    preferred-width: 960px;
    preferred-height: 640px;

    in-out property <string> file-path: "Untitled";
    in-out property <string> text-content: "";
    in-out property <string> hex-offset-text: "";
    in-out property <string> hex-content-text: "";
    in-out property <string> hex-ascii-text: "";
    in-out property <int> edit-mode: 0; // 0: 文字模式 (Text), 1: 列塊模式 (Column), 2: 十六進位模式 (Hex)
    in-out property <[string]> encoding-list: ["UTF-8", "UTF-16LE", "UTF-16BE", "Big5", "GBK", "GB18030", "Shift_JIS", "EUC-JP", "EUC-KR", "windows-1252"];
    in-out property <string> encoding-name: "UTF-8";
    in-out property <string> newline-format: "CRLF";
    in-out property <string> status-info: "Ln 1, Col 1";

    callback open-file-clicked();
    callback save-file-clicked();
    callback mode-changed(int);
    callback reinterpret-encoding-clicked(string);
    callback convert-encoding-clicked(string);
    callback text-changed(string);

    VerticalLayout {
        padding: 4px;
        spacing: 4px;

        // 頂部工具列：提供檔案讀寫、編輯模式切換與字元編碼操作
        HorizontalLayout {
            spacing: 8px;
            height: 32px;

            Button {
                text: "開啟舊檔";
                clicked => { root.open-file-clicked(); }
            }
            Button {
                text: "儲存檔案";
                clicked => { root.save-file-clicked(); }
            }

            Rectangle { width: 12px; }

            Button {
                text: "文字模式";
                primary: root.edit-mode == 0;
                clicked => { root.mode-changed(0); }
            }
            Button {
                text: "列塊模式";
                primary: root.edit-mode == 1;
                clicked => { root.mode-changed(1); }
            }
            Button {
                text: "十六進位模式";
                primary: root.edit-mode == 2;
                clicked => { root.mode-changed(2); }
            }

            Rectangle { width: 12px; }

            ComboBox {
                width: 130px;
                model: root.encoding-list;
                current-value <=> root.encoding-name;
            }
            Button {
                text: "重新解碼";
                clicked => { root.reinterpret-encoding-clicked(root.encoding-name); }
            }
            Button {
                text: "轉換編碼";
                clicked => { root.convert-encoding-clicked(root.encoding-name); }
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                vertical-alignment: center;
                text: "檔案: " + root.file-path;
                color: #555555;
            }
        }

        // 編輯檢視區：依當前編輯模式切換顯示文字編輯器或十六進位三欄檢視器
        Rectangle {
            vertical-stretch: 1;
            background: #ffffff;
            border-width: 1px;
            border-color: #d0d0d0;

            if root.edit-mode != 2 : TextEdit {
                width: 100%;
                height: 100%;
                text <=> root.text-content;
                edited(str) => { root.text-changed(str); }
                font-family: "Consolas, Courier New, monospace";
                font-size: 14px;
            }

            if root.edit-mode == 2 : ScrollView {
                width: 100%;
                height: 100%;

                HorizontalLayout {
                    spacing: 12px;
                    padding: 8px;

                    // 位址偏移欄（Offset）
                    Text {
                        text: root.hex-offset-text;
                        font-family: "Consolas, Courier New, monospace";
                        font-size: 13px;
                        color: #00008b;
                    }

                    // 十六進位位元組欄（Hex Dump）
                    Text {
                        text: root.hex-content-text;
                        font-family: "Consolas, Courier New, monospace";
                        font-size: 13px;
                        color: #222222;
                    }

                    // 可視 ASCII 預覽欄（ASCII Dump）
                    Text {
                        text: root.hex-ascii-text;
                        font-family: "Consolas, Courier New, monospace";
                        font-size: 13px;
                        color: #006400;
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        // 底部狀態列：顯示位元組長度、修改標記、無損解碼警告、模式、換行與編碼
        Rectangle {
            height: 24px;
            background: #f0f0f0;
            border-width: 1px;
            border-color: #d8d8d8;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 16px;

                Text {
                    vertical-alignment: center;
                    text: root.status-info;
                    font-size: 12px;
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    vertical-alignment: center;
                    text: "模式: " + (root.edit-mode == 0 ? "Text" : (root.edit-mode == 1 ? "Column" : "Hex"));
                    font-size: 12px;
                }

                Text {
                    vertical-alignment: center;
                    text: "換行: " + root.newline-format;
                    font-size: 12px;
                }

                Text {
                    vertical-alignment: center;
                    text: "編碼: " + root.encoding-name;
                    font-size: 12px;
                }
            }
        }
    }
}
