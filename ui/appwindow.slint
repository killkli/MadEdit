// MadEdit 主視窗
//
// 外觀參照原版 MadEdit（C++ / wxWidgets）：
//   選單列 → 圖示工具列 → 分頁列 → 編輯區 → 多欄位狀態列
// 所有元件皆為自繪的經典 Windows 風格，以還原原版樣貌。

import { ScrollView } from "std-widgets.slint";
import { Theme, ClassicToolButton, ClassicButton, ClassicLineEdit, ClassicCheckBox, ToolbarSeparator } from "theme.slint";
import { MenuDef, MenuItemDef, ClassicMenuBar } from "menubar.slint";

export struct HighlightSpan {
    text: string,
    color: color,
}

export struct VisibleLine {
    line_number: int,
    text: string,
    spans: [HighlightSpan],
    has_selection: bool,
    sel_start_x: length,
    sel_width: length,
    has_caret: bool,
    caret_x: length,
    has_bookmark: bool,
}

export component MainWindow inherits Window {
    // 標題列格式與原版一致：MadEdit - [檔名]
    title: "MadEdit - [" + root.file-path + "]";
    // 應用程式圖示：於工作列 / 標題列顯示專屬圖示（assets/madedit-icon.png）
    icon: @image-url("../assets/madedit-icon.png");
    preferred-width: 1000px;
    preferred-height: 680px;
    min-width: 620px;
    min-height: 400px;
    background: #f0f0f0;

    in-out property <string> file-path: "Untitled";
    in-out property <int> edit-mode: 0; // 0: 文字模式 (Text), 1: 列塊模式 (Column), 2: 十六進位模式 (Hex)
    in-out property <[string]> encoding-list: ["UTF-8"];
    in-out property <string> selected-encoding: "UTF-8";
    in-out property <string> encoding-name: "UTF-8";
    in-out property <string> newline-format: "CRLF";
    in-out property <string> status-info: "Len: 0 bytes";
    in-out property <string> caret-status: "Ln:1 /1  Col:1";

    // 狀態列各欄位（對應原版的六個狀態列面板）
    in-out property <string> status-charpos: "CharPos:0 /0";
    in-out property <string> status-selsize: "SelSize:0";
    in-out property <string> status-encoding: "UTF-8.DOS";
    in-out property <string> status-insert: "INS";

    // 自繪編輯器屬性
    in-out property <[VisibleLine]> visible-lines: [];
    in-out property <length> line-height: 20px;
    in-out property <length> gutter-width: 52px;
    in-out property <bool> caret-visible: true;

    // 十六進位檢視區屬性
    in-out property <string> hex-offset-text: "";
    in-out property <string> hex-content-text: "";
    in-out property <string> hex-ascii-text: "";

    // 選單列模型（由 Rust 端依功能狀態建構）
    in-out property <[MenuDef]> menus: [];

    // 搜尋與取代面板屬性
    in-out property <bool> show-search-panel: false;
    in-out property <bool> show-replace: false;
    in-out property <string> search-query: "";
    in-out property <string> replace-text: "";
    in-out property <string> search-status-text: "";
    in-out property <bool> search-match-case: false;
    in-out property <bool> search-whole-word: false;
    in-out property <bool> search-use-regex: false;

    // 語法突顯屬性
    in-out property <[string]> syntax-list: ["Plain Text"];
    in-out property <string> current-syntax: "Plain Text";

    // 換行格式屬性
    in-out property <[string]> newline-list: ["CRLF (Windows)", "LF (Unix/macOS)", "CR (Classic Mac)"];
    in-out property <string> selected-newline: "CRLF (Windows)";

    // 指定行號跳轉面板屬性
    in-out property <bool> show-goto-panel: false;
    in-out property <string> goto-label-text: "移至行 (1 - 1):";
    in-out property <string> goto-input-text: "1";

    // 外部檔案變更通知屬性
    in-out property <bool> is-modified: false;
    in-out property <bool> has-external-change: false;

    // 通用選單選擇面板（語法 / 編碼 / 換行格式的挑選清單）
    in-out property <bool> picker-open: false;
    in-out property <string> picker-title: "";
    in-out property <[string]> picker-options: [];
    in-out property <string> picker-current: "";
    in-out property <string> picker-action: "";
    in-out property <length> picker-x: 4px;

    callback open-file-clicked();
    callback save-file-clicked();
    callback mode-changed(int);
    callback reinterpret-encoding-clicked(string);
    callback convert-encoding-clicked(string);
    callback syntax-changed(string);
    callback newline-format-changed(string);
    callback goto-confirmed(string);
    callback goto-cancelled();
    callback reload-file();
    callback ignore-external-change();

    // 搜尋與取代回呼
    callback find-next-clicked();
    callback find-prev-clicked();
    callback replace-clicked();
    callback replace-all-clicked();
    callback close-search-panel();
    callback search-options-changed();
    callback search-query-changed(string);
    callback toggle-replace-clicked();

    // 選單列 / 工具列共用：所有功能以動作識別碼交由 Rust 端處理
    callback menu-action(string);

    // 由 Rust 端要求彈出通用選擇面板
    callback show-picker();

    // 編輯器互動回呼
    callback key-pressed(string, bool, bool, bool) -> bool;
    callback mouse-clicked(length, length, bool);
    callback mouse-dragged(length, length, bool);
    callback scrolled(float);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ── 選單列 ────────────────────────────────────────────
        ClassicMenuBar {
            menus: root.menus;
            menu-action(action) => { root.menu-action(action); }
        }

        // ── 工具列（原版為 16x16 圖示按鈕）────────────────────
        Rectangle {
            height: 28px;
            background: #f0f0f0;

            HorizontalLayout {
                padding-left: 3px;
                padding-right: 3px;
                spacing: 1px;
                alignment: center;

                ClassicToolButton {
                    icon: @image-url("../assets/icons/new.png");
                    tooltip: "新增檔案 (Ctrl+N)";
                    clicked => { root.menu-action("new"); }
                }
                ClassicToolButton {
                    icon: @image-url("../assets/icons/fileopen.png");
                    tooltip: "開啟舊檔 (Ctrl+O)";
                    clicked => { root.open-file-clicked(); }
                }
                ClassicToolButton {
                    icon: @image-url("../assets/icons/filesave.png");
                    tooltip: "儲存檔案 (Ctrl+S)";
                    clicked => { root.save-file-clicked(); }
                }
                ClassicToolButton {
                    icon: @image-url("../assets/icons/saveall.png");
                    tooltip: "全部儲存";
                    enabled: false;
                }

                ToolbarSeparator {}

                ClassicToolButton {
                    icon: @image-url("../assets/icons/undo.png");
                    tooltip: "復原 (Ctrl+Z) — 尚未實作";
                    enabled: false;
                }
                ClassicToolButton {
                    icon: @image-url("../assets/icons/redo.png");
                    tooltip: "重做 (Ctrl+Y) — 尚未實作";
                    enabled: false;
                }

                ToolbarSeparator {}

                ClassicToolButton {
                    icon: @image-url("../assets/icons/cut.png");
                    tooltip: "剪下 (Ctrl+X)";
                    clicked => { root.menu-action("cut"); }
                }
                ClassicToolButton {
                    icon: @image-url("../assets/icons/copy.png");
                    tooltip: "複製 (Ctrl+C)";
                    clicked => { root.menu-action("copy"); }
                }
                ClassicToolButton {
                    icon: @image-url("../assets/icons/paste.png");
                    tooltip: "貼上 (Ctrl+V)";
                    clicked => { root.menu-action("paste"); }
                }

                ToolbarSeparator {}

                ClassicToolButton {
                    icon: @image-url("../assets/icons/find.png");
                    tooltip: "尋找 (Ctrl+F)";
                    clicked => { root.menu-action("find"); }
                }
                ClassicToolButton {
                    icon: @image-url("../assets/icons/findnext.png");
                    tooltip: "尋找下一個 (F3)";
                    clicked => { root.find-next-clicked(); }
                }
                ClassicToolButton {
                    icon: @image-url("../assets/icons/findprev.png");
                    tooltip: "尋找上一個 (Shift+F3)";
                    clicked => { root.find-prev-clicked(); }
                }
                ClassicToolButton {
                    icon: @image-url("../assets/icons/replace.png");
                    tooltip: "取代 (Ctrl+H)";
                    clicked => { root.menu-action("replace"); }
                }

                ToolbarSeparator {}

                ClassicToolButton {
                    icon: @image-url("../assets/icons/textmode.png");
                    tooltip: "文字模式 (Alt+1)";
                    checked: root.edit-mode == 0;
                    clicked => { root.mode-changed(0); }
                }
                ClassicToolButton {
                    icon: @image-url("../assets/icons/columnmode.png");
                    tooltip: "欄位模式 (Alt+2)";
                    checked: root.edit-mode == 1;
                    clicked => { root.mode-changed(1); }
                }
                ClassicToolButton {
                    icon: @image-url("../assets/icons/hexmode.png");
                    tooltip: "十六進位模式 (Alt+3)";
                    checked: root.edit-mode == 2;
                    clicked => { root.mode-changed(2); }
                }

                ToolbarSeparator {}

                ClassicToolButton {
                    icon: @image-url("../assets/icons/bookmark_toggle.png");
                    tooltip: "切換書籤 (Ctrl+F2)";
                    clicked => { root.menu-action("bookmark-toggle"); }
                }
                ClassicToolButton {
                    icon: @image-url("../assets/icons/bookmark_next.png");
                    tooltip: "下一個書籤 (F2)";
                    clicked => { root.menu-action("bookmark-next"); }
                }
                ClassicToolButton {
                    icon: @image-url("../assets/icons/bookmark_prev.png");
                    tooltip: "上一個書籤 (Shift+F2)";
                    clicked => { root.menu-action("bookmark-prev"); }
                }
                ClassicToolButton {
                    icon: @image-url("../assets/icons/bookmark_clear.png");
                    tooltip: "清除所有書籤";
                    clicked => { root.menu-action("bookmark-clear"); }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        // 工具列與內容區的分隔線
        Rectangle { height: 1px; background: #b0b0b0; }

        // ── 分頁列（對應原版的 wxAuiNotebook 分頁）────────────
        Rectangle {
            height: 24px;
            background: #f0f0f0;

            HorizontalLayout {
                padding-left: 2px;
                padding-top: 2px;

                Rectangle {
                    width: 220px;
                    height: 22px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #808080;
                    border-top-left-radius: 3px;
                    border-top-right-radius: 3px;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;

                        Text {
                            vertical-alignment: center;
                            text: root.file-path + (root.is-modified ? "*" : "");
                            color: #000000;
                            font-size: 13px;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        Text {
                            visible: root.has-external-change;
                            text: "⚠";
                            color: #b45309;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        // ── 搜尋與取代面板 ─────────────────────────────────────
        if root.show-search-panel : Rectangle {
            height: root.show-replace ? 76px : 48px;
            background: #f0f0f0;
            border-width: 1px;
            border-color: #a0a0a0;

            VerticalLayout {
                padding: 6px;
                padding-left: 10px;
                spacing: 6px;

                // 第一行：搜尋列
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: "尋找(&N):";
                        vertical-alignment: center;
                        font-size: 13px;
                        color: #000000;
                    }

                    search-input := ClassicLineEdit {
                        width: 220px;
                        placeholder: "輸入關鍵字...";
                        text <=> root.search-query;
                        edited(t) => { root.search-query-changed(t); }
                        accepted => { root.find-next-clicked(); }
                        init => { self.focus(); }
                    }

                    ClassicButton {
                        text: "◀";
                        width: 30px;
                        clicked => { root.find-prev-clicked(); }
                    }
                    ClassicButton {
                        text: "▶";
                        width: 30px;
                        clicked => { root.find-next-clicked(); }
                    }

                    Text {
                        vertical-alignment: center;
                        text: root.search-status-text;
                        font-size: 12px;
                        color: #404040;
                        width: 76px;
                    }

                    ClassicCheckBox {
                        text: "大小寫";
                        width: 72px;
                        checked <=> root.search-match-case;
                        toggled => { root.search-options-changed(); }
                    }
                    ClassicCheckBox {
                        text: "全字";
                        width: 60px;
                        checked <=> root.search-whole-word;
                        toggled => { root.search-options-changed(); }
                    }
                    ClassicCheckBox {
                        text: "Regex";
                        width: 64px;
                        checked <=> root.search-use-regex;
                        toggled => { root.search-options-changed(); }
                    }

                    ClassicButton {
                        text: root.show-replace ? "隱藏取代" : "展開取代";
                        clicked => { root.toggle-replace-clicked(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    ClassicButton {
                        text: "✕";
                        width: 28px;
                        clicked => { root.close-search-panel(); }
                    }
                }

                // 第二行：取代列
                if root.show-replace : HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: "取代(&R):";
                        vertical-alignment: center;
                        font-size: 13px;
                        color: #000000;
                    }

                    ClassicLineEdit {
                        width: 220px;
                        placeholder: "輸入取代內容...";
                        text <=> root.replace-text;
                        accepted => { root.replace-clicked(); }
                    }

                    ClassicButton {
                        text: "取代";
                        width: 60px;
                        clicked => { root.replace-clicked(); }
                    }

                    ClassicButton {
                        text: "全部取代";
                        width: 78px;
                        clicked => { root.replace-all-clicked(); }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        // ── 指定行號跳轉面板 ───────────────────────────────────
        if root.show-goto-panel : Rectangle {
            height: 40px;
            background: #f0f0f0;
            border-width: 1px;
            border-color: #a0a0a0;

            HorizontalLayout {
                padding: 6px;
                padding-left: 10px;
                spacing: 8px;
                alignment: center;

                Text {
                    text: root.goto-label-text;
                    vertical-alignment: center;
                    font-size: 13px;
                    color: #000000;
                }

                goto-input := ClassicLineEdit {
                    width: 160px;
                    placeholder: "例如: 42 或 42:10";
                    text <=> root.goto-input-text;
                    accepted => { root.goto-confirmed(self.text); }
                    init => { self.focus(); }
                }

                ClassicButton {
                    text: "跳轉";
                    width: 60px;
                    clicked => { root.goto-confirmed(goto-input.text); }
                }

                ClassicButton {
                    text: "取消";
                    width: 60px;
                    clicked => { root.goto-cancelled(); }
                }

                Rectangle { horizontal-stretch: 1; }

                ClassicButton {
                    text: "✕";
                    width: 28px;
                    clicked => { root.goto-cancelled(); }
                }
            }
        }

        // ── 外部檔案變更通知橫幅 ───────────────────────────────
        if root.has-external-change : Rectangle {
            height: 32px;
            background: #fff3cd;
            border-width: 1px;
            border-color: #e0a800;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 12px;
                alignment: center;

                Text {
                    text: "⚠️ 檔案已被外部程式修改。";
                    vertical-alignment: center;
                    font-size: 13px;
                    font-weight: 600;
                    color: #7c4a03;
                }

                if root.is-modified : Text {
                    text: "（當前有未儲存修改，重新載入將捨棄變更！）";
                    vertical-alignment: center;
                    font-size: 12px;
                    font-weight: 700;
                    color: #b91c1c;
                }

                Rectangle { horizontal-stretch: 1; }

                ClassicButton {
                    text: "重新載入";
                    width: 78px;
                    clicked => { root.reload-file(); }
                }

                ClassicButton {
                    text: "忽略";
                    width: 56px;
                    clicked => { root.ignore-external-change(); }
                }
            }
        }

        // ── 編輯檢視區 ────────────────────────────────────────
        Rectangle {
            vertical-stretch: 1;
            background: #ffffff;
            border-width: 1px;
            border-color: #808080;
            clip: true;

            if root.edit-mode != 2 : FocusScope {
                key-pressed(event) => {
                    if (root.key-pressed(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt)) {
                        return accept;
                    }
                    return reject;
                }

                HorizontalLayout {
                    // 左側行號欄（Line Number Gutter）
                    Rectangle {
                        width: root.gutter-width;
                        background: #f7f7f7;
                        border-width: 1px;
                        border-color: #e0e0e0;

                        for line[i] in root.visible-lines : Rectangle {
                            x: 0;
                            y: i * root.line-height;
                            width: root.gutter-width;
                            height: root.line-height;

                            // 書籤標記：藍色小圓點
                            if line.has_bookmark : Rectangle {
                                x: 6px;
                                y: (root.line-height - 8px) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #2f5fb0;
                            }

                            Text {
                                x: 0;
                                y: 0;
                                width: root.gutter-width - 8px;
                                height: root.line-height;
                                text: line.line_number > 0 ? (line.line_number + "") : "";
                                color: line.has_bookmark ? #1d4ed8 : #707070;
                                font-family: "Consolas, Courier New, monospace";
                                font-size: 13px;
                                font-weight: line.has_bookmark ? 700 : 400;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 右側文字內容與選取/游標繪製區
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #ffffff;
                        clip: true;

                        TouchArea {
                            property <bool> is-alt-down: false;
                            pointer-event(event) => {
                                self.is-alt-down = event.modifiers.alt;
                                if (event.kind == PointerEventKind.down) {
                                    root.mouse-clicked(self.mouse-x, self.mouse-y, event.modifiers.alt);
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.mouse-dragged(self.mouse-x, self.mouse-y, self.is-alt-down);
                                }
                            }
                            scroll-event(event) => {
                                root.scrolled(event.delta-y / 1px);
                                return accept;
                            }
                        }

                        // 1. 選取反白層（底層）
                        for line[i] in root.visible-lines : Rectangle {
                            if line.has_selection : Rectangle {
                                x: line.sel_start_x;
                                y: i * root.line-height;
                                width: line.sel_width;
                                height: root.line-height;
                                background: #b7d5f5;
                            }
                        }

                        // 2. 游標層（中層）
                        for line[i] in root.visible-lines : Rectangle {
                            if line.has_caret && root.caret-visible : Rectangle {
                                x: line.caret_x;
                                y: i * root.line-height;
                                width: 2px;
                                height: root.line-height;
                                background: #000000;
                            }
                        }

                        // 3. 文字內容層（頂層：支援語法多色分段渲染與單色回退）
                        for line[i] in root.visible-lines : HorizontalLayout {
                            x: 0;
                            y: i * root.line-height;
                            height: root.line-height;
                            spacing: 0px;
                            alignment: start;

                            if line.spans.length > 0 : HorizontalLayout {
                                spacing: 0px;
                                for span in line.spans : Text {
                                    text: span.text;
                                    font-family: "Consolas, Courier New, monospace";
                                    font-size: 14px;
                                    color: span.color;
                                    vertical-alignment: center;
                                }
                            }

                            if line.spans.length == 0 : Text {
                                text: line.text;
                                font-family: "Consolas, Courier New, monospace";
                                font-size: 14px;
                                color: #000000;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            if root.edit-mode == 2 : ScrollView {
                width: 100%;
                height: 100%;

                HorizontalLayout {
                    spacing: 12px;
                    padding: 8px;

                    // 位址偏移欄（Offset）
                    Text {
                        text: root.hex-offset-text;
                        font-family: "Consolas, Courier New, monospace";
                        font-size: 13px;
                        color: #00008b;
                    }

                    // 十六進位位元組欄（Hex Dump）
                    Text {
                        text: root.hex-content-text;
                        font-family: "Consolas, Courier New, monospace";
                        font-size: 13px;
                        color: #000000;
                    }

                    // 可視 ASCII 預覽欄（ASCII Dump）
                    Text {
                        text: root.hex-ascii-text;
                        font-family: "Consolas, Courier New, monospace";
                        font-size: 13px;
                        color: #006400;
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        // ── 狀態列（六個欄位，對應原版 MadEdit 的狀態列配置）────
        Rectangle {
            height: 22px;
            background: #f0f0f0;
            border-width: 1px;
            border-color: #b0b0b0;

            HorizontalLayout {
                padding-left: 0px;
                padding-right: 0px;
                spacing: 0px;

                // 欄位 1：行 / 欄
                Rectangle {
                    width: 152px;
                    height: 22px;
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: root.caret-status;
                        font-size: 12px;
                        color: #202020;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { x: parent.width - 1px; y: 2px; width: 1px; height: parent.height - 4px; background: #b0b0b0; }
                    Rectangle { x: parent.width; y: 2px; width: 1px; height: parent.height - 4px; background: #ffffff; }
                }

                // 欄位 2：字元位置 / 檔案大小
                Rectangle {
                    width: 132px;
                    height: 22px;
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: root.status-charpos;
                        font-size: 12px;
                        color: #202020;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { x: parent.width - 1px; y: 2px; width: 1px; height: parent.height - 4px; background: #b0b0b0; }
                    Rectangle { x: parent.width; y: 2px; width: 1px; height: parent.height - 4px; background: #ffffff; }
                }

                // 欄位 3：選取大小
                Rectangle {
                    width: 92px;
                    height: 22px;
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: root.status-selsize;
                        font-size: 12px;
                        color: #202020;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { x: parent.width - 1px; y: 2px; width: 1px; height: parent.height - 4px; background: #b0b0b0; }
                    Rectangle { x: parent.width; y: 2px; width: 1px; height: parent.height - 4px; background: #ffffff; }
                }

                Rectangle { horizontal-stretch: 1; }

                // 欄位 4：編碼 / 換行格式
                Rectangle {
                    width: 132px;
                    height: 22px;
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: root.status-encoding;
                        font-size: 12px;
                        color: #202020;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                    Rectangle { x: 0; y: 2px; width: 1px; height: parent.height - 4px; background: #b0b0b0; }
                    Rectangle { x: 1px; y: 2px; width: 1px; height: parent.height - 4px; background: #ffffff; }
                }

                // 欄位 5：唯讀標記
                Rectangle {
                    width: 58px;
                    height: 22px;
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: "";
                        font-size: 12px;
                        color: #202020;
                        vertical-alignment: center;
                    }
                    Rectangle { x: 0; y: 2px; width: 1px; height: parent.height - 4px; background: #b0b0b0; }
                    Rectangle { x: 1px; y: 2px; width: 1px; height: parent.height - 4px; background: #ffffff; }
                }

                // 欄位 6：插入 / 覆寫模式
                Rectangle {
                    width: 52px;
                    height: 22px;
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: root.status-insert;
                        font-size: 12px;
                        color: #202020;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                    Rectangle { x: 0; y: 2px; width: 1px; height: parent.height - 4px; background: #b0b0b0; }
                    Rectangle { x: 1px; y: 2px; width: 1px; height: parent.height - 4px; background: #ffffff; }
                }
            }
        }
    }

    // ── 通用選擇面板（語法 / 編碼 / 換行格式）──────────────────
    show-picker => {
        popup.show();
    }

    popup := PopupWindow {
        x: root.picker-x;
        y: 26px;
        width: 220px;
        height: min(root.picker-options.length, 12) * 20px + 6px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: #ffffff;
            border-width: 1px;
            border-color: #707070;

            ScrollView {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;

                VerticalLayout {
                    padding: 2px;
                    spacing: 0px;

                    for option in root.picker-options : Rectangle {
                        height: 20px;
                        background: option == root.picker-current ? #0a246a
                            : (item-touch.has-hover ? #dcdcdc : transparent);

                        Text {
                            x: 6px;
                            width: parent.width - 12px;
                            height: parent.height;
                            text: option;
                            color: option == root.picker-current ? #ffffff : #000000;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        item-touch := TouchArea {
                            clicked => {
                                root.picker-open = false;
                                popup.close();
                                root.menu-action(root.picker-action + "|" + option);
                            }
                        }
                    }
                }
            }
        }
    }
}
