// 經典 Windows（MadEdit 原版）風格共用元件庫
//
// 設計理念：
//   * 原版 MadEdit 使用 wxWidgets 原生工具列、選單列與狀態列，整體呈現
//     Windows 傳統樣式：灰色機箱、3D 立體框線、等寬字體編輯區。
//   * Slint 內建的 Fluent 樣式（圓角、藍色主按鈕）與原版差異極大，
//     因此本檔自行實作貼近原版外觀的元件。
//   * 所有元件以 Theme 為基底，統一管理配色，避免各處散落色碼。

export component Theme inherits Rectangle {
    // ── 機箱配色 ───────────────────────────────────────────────
    in-out property <color> chrome: #f0f0f0;      // 選單列 / 工具列背景
    in-out property <color> chrome-dark: #d4d0c8; // 按鈕面（Win98 灰）
    in-out property <color> face: #ffffff;         // 內容面
    in-out property <color> field: #ffffff;        // 輸入框背景

    // ── 文字 ──────────────────────────────────────────────────
    in-out property <color> text-color: #000000;
    in-out property <color> text-dim: #707070;
    in-out property <color> text-disabled: #a6a6a6;

    // ── 3D 框線 ───────────────────────────────────────────────
    in-out property <color> bevel-dark: #808080;   // 凹陷：上 / 左
    in-out property <color> bevel-light: #dfdfdf;  // 凹陷：下 / 右
    in-out property <color> edge: #a0a0a0;         // 面板外框

    // ── 互動狀態 ───────────────────────────────────────────────
    in-out property <color> highlight: #0a246a;    // 選單 / 選取高亮（經典深藍）
    in-out property <color> select-bg: #b7d5f5;    // 文字選取背景
    in-out property <color> select-fg: #000000;
    in-out property <color> hover: #dcdcdc;
    in-out property <color> pressed: #bfbfbf;
}

// ── 工具列圖示按鈕 ────────────────────────────────────────────────
// 原版 MadEdit 工具列為 16x16 圖示按鈕，無文字，滑鼠停留時顯示提示。
export component ClassicToolButton inherits Theme {
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> checked: false;
    in property <string> tooltip: "";
    callback clicked();

    width: 26px;
    height: 24px;
    border-radius: 2px;
    background: root.checked ? #dce4f2
        : (root.enabled && touch.has-hover ? root.hover : transparent);

    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        // 停用時以灰色淡化，對應原版 disabled 圖示的處理方式
        colorize: root.enabled ? transparent : #9a9a9a;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        // 滑鼠移入時顯示經典黃色提示框
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                tip-popup.show();
            } else {
                tip-popup.close();
            }
        }
    }

    // 量測提示文字寬度（透明且置於按鈕外，僅供提示框計算尺寸）
    measure := Text {
        text: root.tooltip;
        opacity: 0;
        x: 0;
        y: 0;
    }

    // 經典 Windows 樣式的提示框（黃底黑框）
    tip-popup := PopupWindow {
        x: (root.width - self.width) / 2;
        y: root.height + 2px;
        width: max(90px, measure.width + 14px);
        height: 22px;
        close-policy: no-auto-close;

        Rectangle {
            background: #ffffe1;
            border-width: 1px;
            border-color: #000000;

            Text {
                x: 6px;
                width: parent.width - 12px;
                height: parent.height;
                text: root.tooltip;
                color: #000000;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// ── 一般按鈕 ──────────────────────────────────────────────────────
export component ClassicButton inherits Theme {
    in property <string> text: "";
    in property <bool> enabled: true;
    callback clicked();

    height: 24px;
    border-radius: 2px;
    background: root.enabled ? (touch.pressed ? root.pressed : (touch.has-hover ? root.hover : root.chrome-dark))
        : root.chrome-dark;

    // 浮起框線：上 / 左為亮色，下 / 右為暗色
    Rectangle { x: 0; y: 0; width: root.width - 1px; height: 1px; background: root.enabled ? #ffffff : #d4d0c8; }
    Rectangle { x: 0; y: 0; width: 1px; height: root.height - 1px; background: root.enabled ? #ffffff : #d4d0c8; }
    Rectangle { x: 0; y: root.height - 1px; width: root.width - 1px; height: 1px; background: root.enabled ? #808080 : #c0c0c0; }
    Rectangle { x: root.width - 1px; y: 0; width: 1px; height: root.height - 1px; background: root.enabled ? #808080 : #c0c0c0; }

    Text {
        x: 6px;
        width: root.width - 12px;
        height: root.height;
        text: root.text;
        color: root.enabled ? root.text-color : root.text-disabled;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// ── 輸入框（凹陷框線 + 原生 TextInput）────────────────────────────
export component ClassicLineEdit inherits Theme {
    in-out property <string> text: "";
    in property <string> placeholder: "";
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    callback edited(string);
    callback accepted();

    height: 22px;
    background: root.field;
    clip: true;
    // 將鍵盤焦點轉發給內部的 TextInput，讓外部可呼叫 focus()
    forward-focus: input;

    // 凹陷框線
    Rectangle { x: 0; y: 0; width: root.width; height: 1px; background: root.bevel-dark; }
    Rectangle { x: 0; y: 0; width: 1px; height: root.height; background: root.bevel-dark; }
    Rectangle { x: 0; y: root.height - 1px; width: root.width; height: 1px; background: root.bevel-light; }
    Rectangle { x: root.width - 1px; y: 0; width: 1px; height: root.height; background: root.bevel-light; }

    input := TextInput {
        property <length> computed-x;

        x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
        y: 2px;
        width: max(parent.width - self.text-cursor-width, self.preferred-width);
        height: root.height - 4px;
        text <=> root.text;
        color: root.text-color;
        font-size: 13px;
        single-line: true;
        read-only: root.read-only;
        selection-background-color: root.highlight;
        selection-foreground-color: #ffffff;
        vertical-alignment: center;

        cursor-position-changed(cursor-position) => {
            if cursor-position.x + self.computed-x < 0 {
                self.computed-x = -cursor-position.x;
            } else if cursor-position.x + self.computed-x > root.width - self.text-cursor-width {
                self.computed-x = root.width - cursor-position.x - self.text-cursor-width;
            }
        }

        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
    }

    if root.text == "" : Text {
        x: 4px;
        width: root.width - 8px;
        height: root.height;
        text: root.placeholder;
        color: root.text-dim;
        font-size: 13px;
        vertical-alignment: center;
    }
}

// ── 核取方塊 ──────────────────────────────────────────────────────
export component ClassicCheckBox inherits Theme {
    in property <string> text: "";
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled();

    height: 18px;

    Rectangle {
        x: 0;
        y: (root.height - 13px) / 2;
        width: 13px;
        height: 13px;
        background: root.checked ? root.highlight : root.field;
        border-width: 1px;
        border-color: root.enabled ? #707070 : #b0b0b0;

        if root.checked : Text {
            width: 13px;
            height: 13px;
            text: "✓";
            color: #ffffff;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 18px;
        width: root.width - 18px;
        height: root.height;
        text: root.text;
        color: root.enabled ? root.text-color : root.text-disabled;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

// ── 工具列分隔線 ──────────────────────────────────────────────────
export component ToolbarSeparator inherits Rectangle {
    width: 1px;
    height: 18px;
    background: transparent;

    Rectangle { x: 0; y: 1px; width: 1px; height: parent.height - 2px; background: #b8b8b8; }
    Rectangle { x: 1px; y: 1px; width: 1px; height: parent.height - 2px; background: #ffffff; }
}
